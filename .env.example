#Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

#Database Configuration (Neon PostgreSQL)
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://username:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@your-neon-host.neon.tech/dbname?sslmode=require

#Redis Configuration
# For Docker development: redis://redis:6379
# For production AWS ElastiCache: redis://your-elasticache-endpoint:6379
# For Upstash: redis://your-upstash-endpoint
REDIS_URL=redis://redis:6379

#Security Configuration
# Get your Arcjet key from: https://app.arcjet.com/
ARCJET_ENV=development
ARCJET_KEY=ajkey_your_arcjet_key_here

# Generate a strong random string (minimum 32 characters)
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_at_least_32_characters_here